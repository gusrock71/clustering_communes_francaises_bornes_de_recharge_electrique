.env
.venv/
.venv-om/
dbt_ingestion.yaml
__pycache__/
*.pyc
.pytest_cache/
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
logs/
mlruns/
mlflow.db
.DS_Store
dbt/seeds/_tmp/

# Données brutes volumineuses (source : S3, cf. ve_pipeline/ingestion) --
# ne doivent jamais être versionnées (poids, secret de source, dépasse la
# limite GitHub de 100 Mo pour plusieurs d'entre elles).
*.csv
*.xlsx
!dbt/seeds/*.csv

# Livrables générés (dossier professionnel, présentation, captures
# OpenMetadata, etc.) -- volumineux, régénérables, gardés hors dépôt git
# (décision du 2026-08-31, étendue au pptx/key le 2026-09-07).
*.docx
*.pptx
*.key

